# Build context is the repository root for BOTH backend and frontend images.
.git
.gitignore

# Python
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.venv
**/venv

# Node
node_modules
frontend/node_modules
frontend/dist

# Secrets / local state (never bake .env into an image)
.env
.env.*
!.env.example
*.log

# Local runtime data: keep only the committed raw snapshots needed for ingestion.
data/*
!data/raw/
data/raw/*
!data/raw/*.jsonl
postgres_data/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
