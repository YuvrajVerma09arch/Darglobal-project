# Secrets / environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/
*.local

# Runtime data (raw snapshots are reproducible, ignored by default)
data/raw/*
!data/raw/.gitkeep
# Committed real snapshots are required for a clean-clone deployment.
!data/raw/*.jsonl
data/processed/*
!data/processed/.gitkeep
# Local model cache downloaded by fastembed at runtime — never commit it.
data/fastembed/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Docker state
postgres_data/

# Prompt-injection self-test corpus + grading key — never commit.
# (The payloads ship in the deployed build via Vercel/nginx, but the
# source files and the answer key must stay out of the repo.)
frontend/public/archive/
frontend/public/security-canaries/
docs/PROMPT_INJECTION_TESTPLAN.md
