# ---------------------------------------------------------------------------
# Copy to .env and fill in values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
# Frontend build-time API base URL (not a secret)
VITE_API_BASE_URL=http://localhost:8000

APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins (no trailing slash).
# For local dev this is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080

# --- Database ---
POSTGRES_USER=darglobal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=realestate_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://darglobal:change-me@db:5432/realestate_ai

# --- Auth / rate limiting ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-long-random-value
RATE_LIMIT_PER_MINUTE=30
CHAT_RATE_LIMIT_PER_MINUTE=12

# --- Embeddings ---
# local = fastembed BGE-small (no API key, 384 dims) | openai = OpenAI embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Only used when EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM (OpenRouter by default, OpenAI-compatible interface) ---
# Any base_url that speaks the OpenAI chat-completions API works here.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=replace-with-your-openrouter-key
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=60
# Optional headers some gateways require
LLM_HTTP_REFERER=https://localhost
LLM_APP_NAME=darglobal-wasalt-ai

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=24
MIN_SEMANTIC_SIMILARITY=0.65
RRF_K=60
CONTEXT_MAX_CHARS=9000
MAX_CONVERSATION_TURNS=8

# --- Scraper ---
SCRAPER_DELAY_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RETRIES=2
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; RealEstateResearchBot/1.0; +https://example.com/bot)
